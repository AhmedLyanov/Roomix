# Clerk authentication routes
NEXT_PUBLIC_CLERK_SIGN_IN_URL=
NEXT_PUBLIC_CLERK_SIGN_UP_URL=
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=

# Clerk
# Public key used by the browser to initialize Clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=

# Secret key used for server-side Clerk operations
# Never expose this value to the client
CLERK_SECRET_KEY=

# Backend API URL
# Example: https://api.example.com
NEXT_PUBLIC_API_URL=

# Socket.IO signaling server URL
# Used for WebRTC signaling and realtime communication
# Example: https://api.example.com
NEXT_PUBLIC_SIGNALING_URL=