# Port on which the backend server will run
PORT=

# MongoDB connection string
MONGO_URI=

# Public base URL of the backend server
# Example: https://api.example.com
BASE_URL=

# URL of the external translation service
# Used by the backend to communicate with the translation/STT service
# Example: http://localhost:8000
TRANSLATION_SERVICE_URL=

# Secret used to verify incoming Clerk webhook requests
CLERK_WEBHOOK_SECRET=

# Clerk backend secret key
# Used for server-side authentication and communication with Clerk
CLERK_SECRET_KEY=

# Public URL of the frontend application
# Used for CORS configuration and communication with the frontend
# Example: https://example.com
FRONTEND_URL=